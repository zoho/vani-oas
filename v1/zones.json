                  "USER",
                  "TEAM",
                  "ORG"
                ]
              },
              "role": {
                "description": "role. Allowed values: EDITOR, COMMENTER, VIEWER, ORGANISER",
                "type": "string",
                "enum": [
                  "EDITOR",
                  "COMMENTER",
                  "VIEWER",
                  "ORGANISER"
                ]
              },
              "resource_id": {
                "pattern": "^[a-f0-9A-F]{8}-[a-f0-9A-F]{4}-[a-f0-9A-F]{4}-[a-f0-9A-F]{4}-[a-f0-9A-F]{12}$",
                "description": "resource id (required)",
