              "description": "version id",
              "type": "string"
            },
            "team_id": {
              "description": "team id",
              "type": "string"
            },
            "copy_members": {
              "description": "copy members",
              "type": "boolean"
            },
            "destination_space_id": {
              "description": "destination space id",
              "type": "string"
            },
            "copy_comments": {
              "description": "copy comments",
              "type": "boolean"
            }
          },
          "required": ["destination_type"]
        }},
        "required": ["duplicate_zone"]
      },
      "UpdateZoneMetaRequest": {
        "type": "object",
        "properties": {"zone_name": {
          "pattern": "^(?:[0-9a-zA-Z_~`#%&\\^\\*\\(\\)\\{\\}\\[\\]\\+\\*\\|=\\-\\.\\$@\\?,:;>\\\\'\\/!\\u0080-\\uFFFF\\s<\"]+)$",
